# Claude API key from https://console.anthropic.com. Without it the app runs in demo mode.
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5        # or claude-sonnet-5-5 for lower cost
# CLAUDE_EFFORT=low                   # low | medium | high
# DEMO_MODE=1                         # force demo mode (keyword rules instead of Claude)

# Your Shopify store. Leave empty to use the built-in demo store (Nordvik Outdoor).
# Create a custom app in Shopify admin > Settings > Apps > Develop apps with the scopes
# read_products, read_inventory, read_orders, read_legal_policies, then paste its Admin API token.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_TOKEN=
# SHOPIFY_API_VERSION=2026-10
# FAQ_PATH=config/faq.md              # answers for topics without a Shopify policy page
# STORE_ABOUT=Outdoor clothing and gear from Sofia, shipping across the EU.

# The shop's domain(s) where the widget is embedded, comma-separated.
# ALLOWED_ORIGINS=https://your-store.com,https://your-store.myshopify.com

# Protect the team dashboard (/admin). Strongly recommended in production.
# ADMIN_TOKEN=

# Spending and abuse limits
# DAILY_BUDGET_USD=5
# CONVERSATION_BUDGET_USD=0.50
# MAX_TURNS=40
# RATE_LIMIT_PER_MINUTE=12
# ASSISTANT_DB=data/assistant.db
